{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>digicatapult/renovate-config"],
  "enabledManagers": ["github-actions", "poetry", "custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Poetry version pinned in CI",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["poetry", "custom.regex"],
      "labels": ["dependencies", "python"]
    },
    {
      "description": "Python is capped below 3.15 until semgrep/semgrep#11979 is fixed",
      "matchManagers": ["poetry"],
      "matchDepNames": ["python"],
      "enabled": false
    }
  ]
}
